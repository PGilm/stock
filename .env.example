# Example environment variables for running the pgStocks Streamlit app
# Copy this file to .env and customize values for your environment.

# Streamlit server settings
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ENABLECORS=false
STREAMLIT_SERVER_ENABLEWEBHOOKS=false
STREAMLIT_SERVER_MAX_UPLOAD_SIZE=200
STREAMLIT_SERVER_RUN_ON_SAVE=false

# Application settings
PGSTOCKS_APP_NAME=pgStocks
PGSTOCKS_STATE_FILE=~/.config/pgStocks/state.json
PGSTOCKS_DB_FILE=~/.config/pgStocks/pgStocks_users.db

# Optional logging / runtime settings
PYTHONUNBUFFERED=1
